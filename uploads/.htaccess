Options -Indexes -ExecCGI
RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .cgi .pl
RemoveType .php .phtml .phar
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|cgi|pl|shtml)(\.|$)">
    Require all denied
</FilesMatch>
<FilesMatch "(?i)^(?![a-f0-9]{32}\.(jpg|png|webp)$).+">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
